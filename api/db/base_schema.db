CREATE SCHEMA epidemiology;

CREATE TABLE epidemiology.dengue_casses (
    id INTEGER PRIMARY KEY,
    casses INTEGER,
    deaths INTEGER,
    date DATE
);

CREATE TABLE epidemiology.laguna_brgy_dengue (
    id INTEGER PRIMARY KEY
    barangay_pcode VARCHAR,
    municipality_pcode VARCHAR,
    start_date DATE,
    end_date DATE,
    casses INTEGER
);

CREATE TABLE epidemiology.laguna_brgy_lepto (
    municipality_pcode VARCHAR,
    barangay_pcode VARCHAR,
    start_date DATE,
    end_date DATE,
    casses INTEGER
)

CREATE SCHEMA rainfall;

CREATE TABLE rainfall.mean_across_laguna (
    date DATE,
    precepiation_mm FLOAT    
);

CREATE TABLE rainfall.rainfall_brgy (
    barangay_pcode VARCHAR,
    start_date DATE,
    end_date DATE,
    precepiation_mm FLOAT
);

CREATE TABLE rainfall.rainfall_muni (
    municipality_pcode VARCHAR,
    date DATE,
    precepiation_mm FLOAT
);

CREATE SCHEMA gis;

CREATE TABLE gis.brgy_flood_hazard (
    barangay_pcode VARCHAR,
    pct_flood_hazard2 FLOAT,
    pct_flood_hazard3 FLOAT
);

CREATE TABLE gis.pcode_lookup (
    barangay_pcode VARCHAR,
    barangay_name VARCHAR,
    municipality_pcode VARCHAR,
    municipality_name VARCHAR
);

CREATE TABLE gis.health_facilities (
    id VARCHAR,
    city VARCHAR,
    amenity VARCHAR,
    name VARCHAR,
    phone VARCHAR,
    website VARCHAR,
    x_value FLOAT,
    y_value FLOAT
);

laguna_barangay_geodata (
  adm4_name VARCHAR,
  adm4_pcode VARCHAR,
  adm3_name VARCHAR
  adm3_pcode VARCHAR,
  area_sqkm FLOAT,
  center_lat FLOAT,
  center_lon FLOAT
);

CREATE TABLE gis.laguna_barangay_geodata_points (
  adm4_pcode VARCHAR,
  x_value FLOAT,
  y_value FLOAT
);

CREATE TABLE gis.laguna_muncipality_geodata (
  adm3_name VARCHAR
  area_sqkm FLOAT
  adm3_pcode VARCHAR
  center_lat FLOAT,
  center_lon FLOAT
);

CREATE TABLE gis.laguna_barangay_geodata_points (
  adm3_pcode FLOAT,
  x_value FLOAT,
  y_value FLOAT
);

CREATE TABLE gis.laguna_danger_level (
  hazard_level VARCHAR,
  variable SMALLINT
);

CREATE TABLE gis.laguna_danger_level_points (
   hazard_levele VARCHAR,
   x_value FLOAT,
   y_value FLOAT
);




